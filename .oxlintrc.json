{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "unicorn", "oxc"],
  "categories": {
    "correctness": "error"
  },
  "rules": {
    "@nx/enforce-module-boundaries": [
      "error",
      {
        "enforceBuildableLibDependency": true,
        "allow": [],
        "depConstraints": [
          {
            "sourceTag": "scope:app",
            "onlyDependOnLibsWithTags": [
              "scope:model",
              "scope:runtime",
              "scope:blocks",
              "scope:adapter",
              "scope:simulator",
              "scope:ui"
            ],
            "bannedExternalImports": ["scratch-blocks", "blockly", "blockly/*"]
          },
          {
            "sourceTag": "scope:model",
            "onlyDependOnLibsWithTags": ["scope:model"],
            "bannedExternalImports": [
              "react",
              "react/*",
              "react-dom",
              "react-dom/*",
              "scratch-blocks",
              "blockly",
              "blockly/*"
            ]
          },
          {
            "sourceTag": "scope:runtime",
            "onlyDependOnLibsWithTags": ["scope:model", "scope:runtime"],
            "bannedExternalImports": [
              "react",
              "react/*",
              "react-dom",
              "react-dom/*",
              "scratch-blocks",
              "blockly",
              "blockly/*"
            ]
          },
          {
            "sourceTag": "scope:blocks",
            "onlyDependOnLibsWithTags": [
              "scope:model",
              "scope:blocks",
              "scope:ui"
            ]
          },
          {
            "sourceTag": "scope:adapter",
            "onlyDependOnLibsWithTags": ["scope:model", "scope:adapter"]
          },
          {
            "sourceTag": "scope:simulator",
            "onlyDependOnLibsWithTags": [
              "scope:model",
              "scope:runtime",
              "scope:simulator"
            ]
          },
          {
            "allSourceTags": ["scope:simulator", "type:core"],
            "onlyDependOnLibsWithTags": ["scope:model", "type:core"]
          },
          {
            "sourceTag": "scope:ui",
            "onlyDependOnLibsWithTags": ["scope:ui"]
          }
        ]
      }
    ],
    "unicorn/no-thenable": "off",
    "no-restricted-imports": [
      "error",
      {
        "paths": [
          {
            "name": "@botlab/model/testing",
            "message": "Test fixtures are for *.spec files; production code gets robot data from RobotModule.catalog."
          }
        ]
      }
    ]
  },
  "env": {
    "builtin": true
  },
  "jsPlugins": ["@nx/oxlint/boundaries-plugin"],
  "ignorePatterns": [
    "**/dist/**",
    "**/node_modules/**",
    "tmp/**",
    "sources/**",
    ".nx/**",
    "coverage/**"
  ],
  "overrides": [
    {
      "files": ["**/bluetooth.spec.ts"],
      "rules": {
        "unicorn/no-useless-spread": "off"
      }
    },
    {
      "files": ["**/*.spec.ts", "**/*.spec.tsx"],
      "rules": {
        "no-restricted-imports": "off"
      }
    }
  ]
}

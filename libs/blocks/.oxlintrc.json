{
  "extends": ["../../.oxlintrc.json"],
  "plugins": ["react", "jsx-a11y"],
  "rules": {
    "react-hooks/exhaustive-deps": "warn",
    "react/set-state-in-effect": "warn",
    "jsx-a11y/prefer-tag-over-role": "warn"
  },
  "overrides": [
    {
      "files": ["**/*.spec.ts", "**/*.spec.tsx"],
      "rules": {
        "@nx/enforce-module-boundaries": [
          "error",
          {
            "enforceBuildableLibDependency": true,
            "allow": [],
            "depConstraints": [
              {
                "sourceTag": "scope:app",
                "onlyDependOnLibsWithTags": [
                  "scope:model",
                  "scope:runtime",
                  "scope:blocks",
                  "scope:adapter",
                  "scope:simulator",
                  "scope:ui"
                ],
                "bannedExternalImports": [
                  "scratch-blocks",
                  "blockly",
                  "blockly/*"
                ]
              },
              {
                "sourceTag": "scope:model",
                "onlyDependOnLibsWithTags": ["scope:model"],
                "bannedExternalImports": [
                  "react",
                  "react/*",
                  "react-dom",
                  "react-dom/*",
                  "scratch-blocks",
                  "blockly",
                  "blockly/*"
                ]
              },
              {
                "sourceTag": "scope:runtime",
                "onlyDependOnLibsWithTags": ["scope:model", "scope:runtime"],
                "bannedExternalImports": [
                  "react",
                  "react/*",
                  "react-dom",
                  "react-dom/*",
                  "scratch-blocks",
                  "blockly",
                  "blockly/*"
                ]
              },
              {
                "sourceTag": "scope:blocks",
                "onlyDependOnLibsWithTags": [
                  "scope:model",
                  "scope:blocks",
                  "scope:ui",
                  "scope:adapter"
                ]
              },
              {
                "sourceTag": "scope:adapter",
                "onlyDependOnLibsWithTags": ["scope:model", "scope:adapter"]
              },
              {
                "sourceTag": "scope:simulator",
                "onlyDependOnLibsWithTags": [
                  "scope:model",
                  "scope:runtime",
                  "scope:simulator"
                ]
              },
              {
                "allSourceTags": ["scope:simulator", "type:core"],
                "onlyDependOnLibsWithTags": ["scope:model", "type:core"]
              },
              {
                "sourceTag": "scope:ui",
                "onlyDependOnLibsWithTags": ["scope:ui"]
              }
            ]
          }
        ]
      }
    }
  ]
}

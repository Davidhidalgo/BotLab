{
  "name": "blocks",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "libs/blocks/src",
  "projectType": "library",
  "tags": ["scope:blocks", "type:ui", "boundary:editor"],
  "// targets": "to see all targets run: nx show project blocks --web",
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "outputs": ["{workspaceRoot}/dist/libs/blocks"],
      "options": {
        "command": "tsc -p libs/blocks/tsconfig.lib.json --outDir dist/libs/blocks"
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "outputs": ["{workspaceRoot}/coverage/libs/blocks"],
      "options": {
        "cwd": "libs/blocks",
        "command": "vitest"
      }
    }
  }
}

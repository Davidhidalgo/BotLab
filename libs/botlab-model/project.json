{
  "name": "botlab-model",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "libs/botlab-model/src",
  "projectType": "library",
  "tags": ["scope:model", "type:domain"],
  "// targets": "to see all targets run: nx show project botlab-model --web",
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "outputs": ["{workspaceRoot}/dist/libs/botlab-model"],
      "options": {
        "command": "tsc -p libs/botlab-model/tsconfig.lib.json --outDir dist/libs/botlab-model"
      }
    }
  }
}

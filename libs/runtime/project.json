{
  "name": "runtime",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "libs/runtime/src",
  "projectType": "library",
  "tags": ["scope:runtime", "type:orchestration"],
  "// targets": "to see all targets run: nx show project runtime --web",
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "outputs": ["{workspaceRoot}/dist/libs/runtime"],
      "options": {
        "command": "tsc -p libs/runtime/tsconfig.lib.json --outDir dist/libs/runtime"
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "outputs": ["{workspaceRoot}/coverage/libs/runtime"],
      "options": {
        "cwd": "libs/runtime",
        "command": "vitest"
      }
    }
  }
}

{
  "name": "simulators-microduck-native",
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "libs/simulators/microduck-native/src",
  "projectType": "library",
  "tags": ["scope:simulator", "target:microduck", "type:integration"],
  "targets": {
    "build": {
      "executor": "@nx/js:tsc",
      "outputs": ["{options.outputPath}"],
      "options": {
        "outputPath": "dist/libs/simulators/microduck-native",
        "main": "libs/simulators/microduck-native/src/index.ts",
        "tsConfig": "libs/simulators/microduck-native/tsconfig.lib.json",
        "assets": ["libs/simulators/microduck-native/*.md"]
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "libs/simulators/microduck-native",
        "command": "vitest run && python3 -m unittest discover -s python/tests"
      }
    }
  }
}

{
  "name": "simulators-microduck",
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "libs/simulators/microduck/src",
  "projectType": "library",
  "tags": ["scope:simulator", "target:microduck", "type:integration"],
  "// targets": "to see all targets run: nx show project simulators-microduck --web",
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "outputs": ["{workspaceRoot}/dist/libs/simulators/microduck"],
      "options": {
        "command": "tsc -p libs/simulators/microduck/tsconfig.lib.json --outDir dist/libs/simulators/microduck"
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "outputs": ["{workspaceRoot}/coverage/libs/simulators/microduck"],
      "options": {
        "cwd": "libs/simulators/microduck",
        "command": "vitest"
      }
    }
  }
}

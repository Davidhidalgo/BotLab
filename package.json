{
  "name": "@botlab/source",
  "version": "0.0.0",
  "license": "MIT",
  "scripts": {
    "dev": "portless botlab corepack pnpm run dev:server",
    "dev:server": "vite --config apps/botlab-web/vite.config.ts",
    "build": "NX_DAEMON=false NX_ISOLATE_PLUGINS=false nx build botlab-web",
    "build:libs": "NX_DAEMON=false NX_ISOLATE_PLUGINS=false nx run-many --target=build --projects=botlab-model,runtime,simulators-core,simulators-microduck,simulators-microduck-native,microduck,stackchan,blocks,ui,simulators-mujoco,simulators-jumper,simulators-microduck-mujoco,jumper",
    "affected:build": "NX_DAEMON=false NX_ISOLATE_PLUGINS=false nx affected --target=build",
    "affected:test": "NX_DAEMON=false NX_ISOLATE_PLUGINS=false nx affected --target=test",
    "affected:lint": "NX_DAEMON=false NX_ISOLATE_PLUGINS=false nx affected --target=lint",
    "test": "NX_DAEMON=false NX_ISOLATE_PLUGINS=false nx test botlab-web",
    "microduck:sim": "node tools/microduck/prepare-official-simulator.mjs",
    "nx": "NX_DAEMON=false NX_ISOLATE_PLUGINS=false nx",
    "test:all": "NX_DAEMON=false NX_ISOLATE_PLUGINS=false nx run-many --target=test --all --parallel=2",
    "test:workspace": "node tools/microduck/verify-workspace.mjs",
    "test:simulator-turns": "node tools/microduck/verify-turns.mjs",
    "test:simulator-native": "pnpm nx build simulators-microduck-native && tmp/microduck-native/venv/bin/python tools/microduck/native/client.py",
    "microduck:native": "tmp/microduck-native/venv/bin/python tools/microduck/native/serve.py",
    "test:simulator-native-app": "node tools/microduck/native/verify-app.mjs",
    "test:simulator-native-video": "node tools/microduck/native/verify-video.mjs",
    "build:simulator-macos": "pnpm nx build simulator-macos",
    "test:simulator-native-posture": "node tools/microduck/native/verify-posture.mjs",
    "test:simulator-postures": "node tools/microduck/verify-postures.mjs",
    "test:simulator-repeats": "node tools/microduck/verify-repeats.mjs",
    "lint:all": "NX_DAEMON=false NX_ISOLATE_PLUGINS=false nx run-many --target=lint --all --parallel=2",
    "typecheck:all": "node tools/ci/typecheck.mjs",
    "verify": "pnpm run format:check --all && pnpm run typecheck:all && pnpm run test:all && pnpm run lint:all && pnpm run test:architecture && pnpm run build:libs && pnpm run build",
    "test:architecture": "NX_DAEMON=false NX_ISOLATE_PLUGINS=false node tools/ci/check-boundaries.mjs",
    "format": "NX_DAEMON=false NX_ISOLATE_PLUGINS=false nx format:write",
    "format:check": "NX_DAEMON=false NX_ISOLATE_PLUGINS=false nx format:check",
    "mujoco:prepare": "python3 tools/mujoco/prepare.py",
    "test:mujoco:web": "node tools/mujoco/verify-browser.mjs",
    "mujoco:prepare:microduck": "python3 tools/mujoco/prepare-microduck.py",
    "test:mujoco:ui": "node tools/mujoco/verify-ui.mjs",
    "mujoco:prepare:jumper-walking": "python3 tools/mujoco/prepare-jumper-walking.py",
    "test:mujoco:jumper-walking": "node tools/mujoco/verify-jumper-walking.mjs",
    "test:mujoco:editing": "node tools/mujoco/verify-editing.mjs",
    "test:mujoco:production": "node tools/mujoco/verify-production.mjs",
    "test:mujoco:workbench": "node tools/mujoco/verify-workbench.mjs",
    "test:mujoco:motion": "node tools/mujoco/verify-motion.mjs",
    "test:mujoco:performance": "node tools/mujoco/verify-performance.mjs",
    "test:mujoco:educational": "node tools/mujoco/verify-educational.mjs",
    "test:mujoco:repeats": "node tools/mujoco/verify-repeats.mjs"
  },
  "private": true,
  "dependencies": {
    "@mujoco/mujoco": "3.11.0",
    "@radix-ui/react-slot": "^1.3.3",
    "@xstate/react": "^6.1.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.43.0",
    "onnxruntime-web": "1.27.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "scratch-blocks": "^2.1.19",
    "tailwind-merge": "^3.6.0",
    "three": "0.164.1",
    "xstate": "^5.32.6"
  },
  "devDependencies": {
    "@nx/jest": "23.2.1",
    "@nx/js": "23.2.1",
    "@nx/oxlint": "23.2.1",
    "@nx/react": "23.2.1",
    "@nx/vite": "23.2.1",
    "@nx/vitest": "23.2.1",
    "@nx/web": "23.2.1",
    "@nx/workspace": "23.2.1",
    "@playwright/test": "1.61.1",
    "@swc-node/register": "1.12.1",
    "@swc/cli": "~0.8.0",
    "@swc/core": "1.16.2",
    "@swc/helpers": "0.5.23",
    "@testing-library/react": "15.0.6",
    "@types/jest": "30.0.0",
    "@types/node": "^22.0.0",
    "@types/react": "18.3.1",
    "@types/react-dom": "18.3.0",
    "@types/three": "0.164.1",
    "@vitejs/plugin-react": "5.2.0",
    "@vitest/coverage-v8": "4.1.9",
    "@vitest/ui": "4.1.9",
    "autoprefixer": "^10.4.20",
    "babel-jest": "30.3.0",
    "jest": "30.3.0",
    "jest-environment-jsdom": "30.0.5",
    "jest-util": "30.0.5",
    "jsdom": "~22.1.0",
    "nx": "23.2.1",
    "oxfmt": "0.68.0",
    "oxlint": "1.83.0",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.16",
    "ts-jest": "^29.1.0",
    "ts-node": "10.9.1",
    "tslib": "^2.3.0",
    "typescript": "6.0.3",
    "vite": "^7.0.0",
    "vitest": "4.1.9"
  },
  "packageManager": "pnpm@10.34.5",
  "engines": {
    "node": ">=22.22.0 <23 || >=24.0.0",
    "pnpm": "10.x"
  },
  "nx": {
    "includedScripts": []
  }
}
